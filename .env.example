# ---- mix2list configuration ----
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values,
# never paste them into a chat. Values live only on your machine.

# Deployment mode: "direct" (key in browser, personal use) or "proxy" (backend hides key)
VITE_BACKEND_MODE=direct

# Gemini (needed in "direct" mode) — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Spotify — https://developer.spotify.com/dashboard  (PKCE: no client secret needed)
VITE_SPOTIFY_CLIENT_ID=
# Must EXACTLY match a Redirect URI registered in the Spotify app settings.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
# GitHub Pages example:
# VITE_SPOTIFY_REDIRECT_URI=https://yujitominaga.github.io/mix2list/callback

# GitHub Pages base path (leave unset for local dev)
# VITE_BASE=/mix2list/

# NOTE: Adobe Fonts (Helvetica Now) is NOT configured here. It uses an embed
# <link> tag pasted into index.html, not an env var. See index.html.
